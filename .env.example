# Variables de entorno para el envío de correos
# Copia este archivo a .env.local y completa con tus valores

# Gmail
GMAIL_USER=tu-correo@gmail.com
GMAIL_PASSWORD=

# Nota: Para Gmail, debes:
# 1. Habilitar autenticación de 2 factores
# 2. Crear una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# 3. Usar esa contraseña aquí (no la contraseña regular de Gmail)
